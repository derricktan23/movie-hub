type Query {
    movies: [Movie!]!
    movie(id: ID!): Movie
    people: [Person!]!
    person(id: ID!): Person
    searchTmdbMovies(query: String!): [TmdbMovieSearchResult!]!
}

type Mutation {
    createMovie(title: String!, releaseYear: Int, artworkUrl: String, pplIds: [ID!]): Movie!
    deleteMovie(id: ID!): Boolean!
    createPerson(name: String!, role: String!): Person!
    deletePerson(id: ID!): Boolean!
}

type Movie {
    id: ID!
    title: String!
    releaseYear: Int
    artworkUrl: String
    pplIds: [ID!]!
    people: [Person!]!
}

type Person {
    id: ID!
    name: String!
    role: String!
}

"""
A movie result returned from the TMDb search API.
posterUrl is pre-built: https://image.tmdb.org/t/p/w500{poster_path}
"""
type TmdbMovieSearchResult {
    tmdbId: ID!
    title: String!
    releaseYear: Int
    posterUrl: String
    overview: String!
}
