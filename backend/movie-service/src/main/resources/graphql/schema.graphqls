type Query {
    movies: [Movie!]!
    movie(id: ID!): Movie
    people: [Person!]!
    person(id: ID!): Person
}

type Mutation {
    createMovie(title: String!, releaseYear: Int, artworkUrl: String, pplIds: [ID!]): Movie!
    deleteMovie(id: ID!): Boolean!
    createPerson(name: String!, role: String!): Person!
    deletePerson(id: ID!): Boolean!
}

type Movie {
    id: ID!
    title: String!
    releaseYear: Int
    artworkUrl: String
    pplIds: [ID!]!
    people: [Person!]!
}

type Person {
    id: ID!
    name: String!
    role: String!
}
